# Copy this file to .env and replace the database placeholders.
# Do not commit .env; it contains credentials.

# Express server
NODE_ENV=development
PORT=3000
# Keep this at 0 locally. Set the exact number of trusted proxies in production.
TRUST_PROXY=0

# MySQL connection. Use a database account limited to this application's tables.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hampshire_hotel
DB_USER=hampshire_app
DB_PASSWORD=replace-with-a-strong-password
DB_SSL=false
DB_CONNECTION_LIMIT=5

# Contact form abuse protection
CONTACT_RATE_LIMIT_WINDOW_MINUTES=15
CONTACT_RATE_LIMIT_MAX=5
CONTACT_EMAIL_RATE_LIMIT_WINDOW_MINUTES=60
CONTACT_EMAIL_RATE_LIMIT_MAX=3
CONTACT_DEDUPLICATION_WINDOW_MINUTES=10
# Comma-separated complete origins permitted to submit the contact form.
# Use the VPS site's HTTPS origin(s), not a path or a Netlify preview address.
CONTACT_ALLOWED_ORIGINS=https://your-domain.example

# Cloudflare Turnstile. Set this to true with valid keys and hostnames in production.
# The site key is public; never expose the secret key in browser code or source control.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ACTION=enquiry
TURNSTILE_ALLOWED_HOSTNAMES=your-domain.example
